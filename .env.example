# Environment switch: dry_run | demo | live (only dry_run is implemented in this slice)
ENV=dry_run
DRY_RUN=true

# MT5 demo broker credentials. The official MetaTrader5 Python package is
# Windows-only, so this Linux-side bot connects through the `mt5linux` RPyC
# bridge. Run `python -m mt5linux <python.exe>` on the Windows host that
# already has the MT5 terminal logged in, then point this Linux process at it.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=18812

# Demo account credentials (preferred). MT5_LOGIN / MT5_PASSWORD / MT5_SERVER
# are honoured as fallbacks for back-compat.
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
